---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Poné las imágenes en src/assets/img/events/ con el nombre del slug
// (ej: blood-castle.jpg, devil-square.webp, chaos-castle.png).
// Si una falta, el banner usa solo el fondo de color.
const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
    "../assets/img/events/*.{jpg,jpeg,png,webp,avif}",
    { eager: true },
);

const findImage = (slug: string) =>
    Object.entries(imageFiles).find(([path]) =>
        path.split("/").pop()?.split(".")[0] === slug,
    )?.[1].default;

/**
 * Horarios tomados de mu-server-config/Data/Event/*.dat.
 * Si cambian en el servidor, actualizalos acá.
 * `duration` = EventTime en minutos (cuánto dura el evento una vez que arranca).
 */
type Slot = { h: number; m: number; label?: string };

// Zona horaria del reloj de la máquina donde corre el GameServer
const SERVER_TIME_ZONE = "America/Argentina/Buenos_Aires";

const everyHours = (step: number, start: number, minute: number): Slot[] =>
    Array.from({ length: 24 / step }, (_, i) => ({ h: start + i * step, m: minute }));

const invasionHours = [0, 4, 8, 12, 16, 20];
const invasions: Slot[] = invasionHours.flatMap((h) => [
    { h, m: 5, label: "Skeleton King" },
    { h, m: 15, label: "Red Dragon" },
    { h, m: h === 8 ? 41 : 25, label: "Golden Dragon" },
    { h, m: 50, label: "White Wizard" },
]);

const events = [
    {
        id: "bc",
        slug: "blood-castle",
        name: "Blood Castle",
        tagline: "Contrarreloj en grupo",
        duration: 15,
        schedule: everyHours(2, 0, 0),
    },
    {
        id: "ds",
        slug: "devil-square",
        name: "Devil Square",
        tagline: "Oleadas de monstruos",
        duration: 20,
        schedule: everyHours(4, 0, 30),
    },
    {
        id: "cc",
        slug: "chaos-castle",
        name: "Chaos Castle",
        tagline: "El último en pie gana",
        duration: 10,
        schedule: everyHours(2, 1, 0),
    },
    {
        id: "inv",
        slug: "invasiones",
        name: "Invasiones",
        tagline: "Jefes que aparecen en el mundo",
        duration: 10,
        schedule: invasions,
    },
].map((event) => ({
    ...event,
    href: `/help#evento-${event.slug}`,
    image: findImage(event.slug),
}));
---

<nav class="event-banners" aria-label="Eventos del servidor" data-time-zone={SERVER_TIME_ZONE}>
    {events.map((event) => (
        <a
            href={event.href}
            class:list={["event-banner", `event-${event.id}`]}
            data-schedule={JSON.stringify(event.schedule)}
            data-duration={event.duration}
        >
            {event.image && (
                <Image
                    src={event.image}
                    alt=""
                    width={480}
                    class="event-photo"
                    loading="lazy"
                />
            )}
            <span class="event-shade" aria-hidden="true"></span>
            <span class="event-text">
                <strong>{event.name}</strong>
                <small>{event.tagline}</small>
            </span>
            <span class="event-next" data-next>&nbsp;</span>
        </a>
    ))}
    <p class="event-tz">Horarios del servidor (hora de Argentina)</p>
</nav>

<script>
    type Slot = { h: number; m: number; label?: string };

    const container = document.querySelector<HTMLElement>(".event-banners");
    const timeZone = container?.dataset.timeZone || "America/Argentina/Buenos_Aires";
    const pad = (n: number) => String(n).padStart(2, "0");

    // Minutos transcurridos del día según el reloj del servidor
    function serverMinutesNow(): number {
        const parts = new Intl.DateTimeFormat("en-GB", {
            timeZone,
            hour: "2-digit",
            minute: "2-digit",
            hourCycle: "h23",
        }).formatToParts(new Date());
        const get = (type: string) => Number(parts.find((p) => p.type === type)?.value ?? 0);
        return get("hour") * 60 + get("minute");
    }

    function formatWait(minutes: number): string {
        if (minutes < 1) return "ahora";
        const h = Math.floor(minutes / 60);
        const m = minutes % 60;
        //   = espacio que no corta línea (evita "en 1" / "h 37 min")
        const text = !h ? `en ${m} min` : m ? `en ${h} h ${m} min` : `en ${h} h`;
        return text.replace(/ /g, " ");
    }

    function update() {
        const now = serverMinutesNow();
        container?.querySelectorAll<HTMLElement>(".event-banner").forEach((banner) => {
            const label = banner.querySelector<HTMLElement>("[data-next]");
            if (!label) return;
            const schedule: Slot[] = JSON.parse(banner.dataset.schedule || "[]");
            const duration = Number(banner.dataset.duration || 0);
            if (!schedule.length) return;

            // ¿Hay uno en curso?
            const running = schedule.find((slot) => {
                const elapsed = (now - (slot.h * 60 + slot.m) + 1440) % 1440;
                return elapsed < duration;
            });
            if (running) {
                label.textContent = `¡En curso!${running.label ? ` ${running.label}` : ""}`;
                banner.classList.add("is-live");
                return;
            }

            // Próximo horario (puede ser al día siguiente)
            const next = schedule
                .map((slot) => ({ slot, wait: (slot.h * 60 + slot.m - now + 1440) % 1440 }))
                .sort((a, b) => a.wait - b.wait)[0];
            const name = next.slot.label ? `${next.slot.label} · ` : "";
            label.textContent = `Próximo: ${name}${pad(next.slot.h)}:${pad(next.slot.m)} · ${formatWait(next.wait)}`;
            banner.classList.remove("is-live");
        });
    }

    update();
    setInterval(update, 30_000);
</script>

<style>
    .event-banners {
        display: grid;
        gap: 8px;
        width: 100%;
    }

    .event-banner {
        --accent: #d83a3a;
        --glow: rgba(216, 58, 58, 0.45);
        --deep: #2a0505;

        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 2px;
        min-height: 78px;
        padding: 10px 12px;
        overflow: hidden;
        isolation: isolate;
        border: 1px solid color-mix(in srgb, var(--accent) 70%, var(--fg));
        border-radius: 5px;
        background:
            radial-gradient(circle at 85% 50%, var(--glow), transparent 60%),
            linear-gradient(135deg, var(--deep), #07030f 75%);
        box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.7);
        color: var(--fg);
        text-decoration: none;
        transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
    }

    .event-ds {
        --accent: #3a8fe0;
        --glow: rgba(58, 143, 224, 0.4);
        --deep: #05162a;
    }

    .event-cc {
        --accent: #4fc26b;
        --glow: rgba(79, 194, 107, 0.38);
        --deep: #06200d;
    }

    .event-inv {
        --accent: #b46cf0;
        --glow: rgba(180, 108, 240, 0.4);
        --deep: #1a0a2a;
    }

    .event-banner:hover,
    .event-banner:focus-visible {
        transform: translateY(-1px);
        border-color: var(--accent);
        box-shadow: inset 0 0 18px rgba(0, 0, 0, 0.5), 0 0 14px var(--glow);
        outline: none;
    }

    .event-photo {
        position: absolute;
        inset: 0;
        z-index: -2;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        object-position: center;
        transition: transform 300ms ease, filter 300ms ease;
        filter: saturate(1.1) brightness(0.85);
    }

    .event-banner:hover .event-photo,
    .event-banner:focus-visible .event-photo {
        transform: scale(1.06);
        filter: saturate(1.25) brightness(1);
    }

    /* Oscurece el lado del texto y tiñe con el color del evento */
    .event-shade {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            linear-gradient(90deg, rgba(5, 2, 12, 0.92) 0%, rgba(5, 2, 12, 0.55) 55%, rgba(5, 2, 12, 0.15) 100%),
            linear-gradient(0deg, color-mix(in srgb, var(--deep) 60%, transparent), transparent 70%);
        pointer-events: none;
    }

    .event-text strong {
        display: block;
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 17px;
        font-weight: 700;
        letter-spacing: 0.5px;
        line-height: 1.1;
        text-transform: uppercase;
        background: linear-gradient(to bottom, #fff3d6, var(--accent));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.9));
    }

    .event-text small {
        display: block;
        margin-top: 3px;
        font-size: 10px;
        opacity: 0.85;
    }

    .event-next {
        margin-top: 6px;
        font-size: 10px;
        font-weight: 700;
        color: color-mix(in srgb, var(--accent) 45%, #fff3d6);
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
    }

    .event-banner.is-live .event-next {
        color: #fff;
    }

    .event-banner.is-live .event-next::before {
        content: "●";
        margin-right: 5px;
        color: var(--accent);
        animation: live-pulse 1.2s ease-in-out infinite;
    }

    .event-tz {
        margin: 2px 0 0;
        font-size: 9px;
        text-align: center;
        opacity: 0.6;
    }

    @keyframes live-pulse {
        50% { opacity: 0.25; }
    }

    @media (prefers-reduced-motion: reduce) {
        .event-banner.is-live .event-next::before { animation: none; }
        .event-banner { transition: none; }
        .event-banner:hover,
        .event-banner:hover .event-photo { transform: none; }
    }
</style>
