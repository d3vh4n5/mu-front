---
interface Props {
  title?: string,
  columns: string[],
  data: (string | number)[][]
  id?: string
}

const { title, columns, data, id } = Astro.props
---

<div class="table-card mu-table-card">
  {title && <h3 class="table-card-title">{title}</h3>}
  <table class="data-table">
    <thead>
      <tr>
        {columns.map(col => <th scope="col">{col}</th>)}
      </tr>
    </thead>
    <tbody id={id}>
      {data.map((row) => (
        <tr>
          {row.map((col) => <td>{col}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .mu-table-card {
    margin: 20px 0;
  }

  /* primera columna (comando / skill) destacada */
  .mu-table-card :global(td:first-child) {
    color: var(--color-gold-soft);
    font-weight: 700;
    white-space: nowrap;
  }
</style>
