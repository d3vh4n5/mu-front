---
/**
 * Movimiento del sitio:
 *  - termina la presentación de entrada (html.intro, activada en el <head> del Layout)
 *  - revela secciones al hacer scroll
 *  - parallax suave del banner y barra de navegación más sólida al bajar
 * Respeta prefers-reduced-motion. Sin JS el contenido se ve normal (no afecta SEO).
 */
---

<script>
  const root = document.documentElement;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Revelar al hacer scroll ----
  const setupReveal = () => {
    if (reduceMotion || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );

    // Bloques del contenido y del lateral; solo los que arrancan fuera de pantalla
    const blocks = document.querySelectorAll<HTMLElement>(
      'main .mid > * > :not(dialog, script, style, template, [hidden]), main .right-container > *',
    );
    const limit = innerHeight * 0.95;
    blocks.forEach((el) => {
      if (el.getBoundingClientRect().top < limit) return;
      el.classList.add('reveal');
      observer.observe(el);
    });
  };

  // ---- Presentación de entrada ----
  // Mientras dura, el contenedor está fuera de pantalla: el revelado se prepara al terminar.
  if (root.classList.contains('intro')) {
    const events = ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const;
    let done = false;
    const end = () => {
      if (done) return;
      done = true;
      root.classList.remove('intro', 'intro-skip');
      events.forEach((ev) => removeEventListener(ev, skip));
      setupReveal();
    };
    // Termina cuando el contenedor llega a su lugar (con un tope por si la animación no corre)
    const timer = setTimeout(end, 4500);
    document.querySelector('main')?.addEventListener('animationend', (event) => {
      if (event.animationName === 'intro-curtain') {
        clearTimeout(timer);
        end();
      }
    });
    function skip() {
      if (done) return;
      clearTimeout(timer);
      root.classList.add('intro-skip');
      setTimeout(end, 450);
    }
    events.forEach((ev) => addEventListener(ev, skip, { passive: true }));
  } else {
    setupReveal();
  }

  // ---- Parallax del banner y barra al hacer scroll ----
  const hero = document.querySelector<HTMLElement>('.hero-img');
  const heroOverlay = document.querySelector<HTMLElement>('.container.full .hero-overlay');
  const nav = document.querySelector<HTMLElement>('header nav');
  let ticking = false;

  // La página scrollea dentro de <body> (html/body con height 100% y overflow),
  // no en window: se lee el scroll de ambos y se escucha en fase de captura.
  const scrollTop = () => Math.max(scrollY, document.body.scrollTop, document.documentElement.scrollTop);

  const onScroll = () => {
    const y = scrollTop();
    nav?.classList.toggle('scrolled', y > 40);
    if (hero && !reduceMotion && y < innerHeight * 1.2) {
      hero.style.translate = `0 ${Math.round(y * 0.3)}px`;
    }
    // el texto sobre el banner se desvanece a medida que sube el contenido
    if (heroOverlay && !reduceMotion && innerWidth > 760) {
      heroOverlay.style.opacity = String(Math.max(0, 1 - y / (innerHeight * 0.55)));
    }
    ticking = false;
  };

  document.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(onScroll);
  }, { passive: true, capture: true });
  onScroll();
</script>
