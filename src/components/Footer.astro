---
import { config } from "../constants/config";
---
<footer>
    <p>{config.project.alias} © 2026, TODOS LOS DERECHOS RESERVADOS. <br>
        Este es un servidor privado de MU Online.
        No estamos afiliados ni respaldados de ninguna manera por Webzen.</p>
    <p>
        ¿Consultas o problemas? Escribinos a <a href={`mailto:${config.contact.email}`}>{config.contact.email}</a>
    </p>
</footer>
<style>
    footer{
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        margin: 0 auto;
        width: 100%;
        max-width: var(--max-w);
        position: relative;
        z-index: 2;
        padding: 0 16px 16px;
        color: var(--fg);
        line-height: 1.5;
    }

    footer a {
        color: var(--color-danger);
    }

    @media (max-width: 480px) {
        footer {
            font-size: 11px;
            text-align: center;
        }
    }
</style>