---
/**
 * Lluvia de bolas de fuego sobre la portada, al estilo de las invasiones de
 * dragones. Durante una invasión de Red/Golden Dragon (hora del servidor) se
 * intensifica. Se pausa fuera de pantalla y respeta "reducir movimiento".
 */
---

<canvas class="fireball-rain" aria-hidden="true"></canvas>

<style>
    /*
     * Capa fija sobre toda la ventana: por encima de la portada y del fondo,
     * pero por debajo del contenido (main/footer tienen z-index 2), así las
     * bolas que pasan por detrás quedan desenfocadas por su backdrop-filter.
     */
    .fireball-rain {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 1;
    }
</style>

<script>
    const SERVER_TIME_ZONE = "America/Argentina/Buenos_Aires";
    // Invasiones de dragones (InvasionManager.dat): horas y minuto de inicio, duran 10 min
    const DRAGON_HOURS = [0, 4, 8, 12, 16, 20];
    const DRAGON_MINUTES = (h: number) => [15, h === 8 ? 41 : 25]; // Red, Golden
    const DRAGON_DURATION = 10;

    type Fireball = {
        x: number; y: number; vx: number; vy: number;
        r: number; groundY: number; life: number;
        // true = cruza toda la pantalla y sale por abajo sin explotar
        long: boolean;
    };
    type Spark = {
        x: number; y: number; vx: number; vy: number;
        life: number; maxLife: number; size: number; hue: number;
    };
    type Blast = { x: number; y: number; t: number; r: number };

    const canvas = document.querySelector<HTMLCanvasElement>(".fireball-rain");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (canvas && !reduceMotion) {
        const ctx = canvas.getContext("2d")!;
        let width = 0;
        let height = 0;
        let dpr = 1;
        let running = false;
        let lastTime = 0;
        let spawnTimer = 0;
        let dragonInvasion = false;

        const fireballs: Fireball[] = [];
        const sparks: Spark[] = [];
        const blasts: Blast[] = [];
        const MAX_SPARKS = 500;

        const rand = (min: number, max: number) => min + Math.random() * (max - min);

        function resize() {
            const rect = canvas!.getBoundingClientRect();
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            width = rect.width;
            height = rect.height;
            canvas!.width = Math.round(width * dpr);
            canvas!.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        // Vista previa del modo invasión: agregar ?invasion a la URL
        const forceInvasion = new URLSearchParams(location.search).has("invasion");

        function checkInvasion() {
            if (forceInvasion) {
                dragonInvasion = true;
                return;
            }
            const parts = new Intl.DateTimeFormat("en-GB", {
                timeZone: SERVER_TIME_ZONE, hour: "2-digit", minute: "2-digit", hourCycle: "h23",
            }).formatToParts(new Date());
            const get = (t: string) => Number(parts.find((p) => p.type === t)?.value ?? 0);
            const now = get("hour") * 60 + get("minute");
            dragonInvasion = DRAGON_HOURS.some((h) =>
                DRAGON_MINUTES(h).some((m) => {
                    const elapsed = now - (h * 60 + m);
                    return elapsed >= 0 && elapsed < DRAGON_DURATION;
                }),
            );
        }

        function spawn() {
            const scale = Math.min(1, width / 900);
            // ~35% cruzan toda la pantalla (más rápidas); el resto explota antes
            const long = Math.random() < 0.35;
            const speed = rand(260, 420) * (0.7 + scale * 0.3) * (long ? 1.35 : 1);
            const angle = long
                ? rand(Math.PI * 0.58, Math.PI * 0.66) // más verticales para recorrer más alto
                : rand(Math.PI * 0.62, Math.PI * 0.72); // hacia abajo-izquierda
            fireballs.push({
                x: rand(width * 0.15, width * 1.3),
                y: rand(-80, -20),
                vx: Math.cos(angle) * speed,
                vy: Math.sin(angle) * speed,
                r: rand(5, 10) * (0.6 + scale * 0.4) * (long ? 1.15 : 1),
                groundY: long ? height + 120 : rand(height * 0.25, height * 0.7),
                life: 0,
                long,
            });
        }

        function addSpark(x: number, y: number, vx: number, vy: number, life: number, size: number) {
            if (sparks.length >= MAX_SPARKS) sparks.shift();
            sparks.push({ x, y, vx, vy, life, maxLife: life, size, hue: rand(15, 45) });
        }

        function explode(f: Fireball) {
            blasts.push({ x: f.x, y: f.y, t: 0, r: f.r * 7 });
            const count = Math.round(f.r * 4);
            for (let i = 0; i < count; i++) {
                const a = rand(Math.PI * 1.05, Math.PI * 1.95); // hacia arriba
                const s = rand(60, 240);
                addSpark(f.x, f.y, Math.cos(a) * s, Math.sin(a) * s, rand(0.4, 0.9), rand(1, 2.4));
            }
        }

        function drawFireball(f: Fireball) {
            const speed = Math.hypot(f.vx, f.vy);
            const dx = f.vx / speed;
            const dy = f.vy / speed;
            const tail = f.r * 11;

            // Estela
            const tx = f.x - dx * tail;
            const ty = f.y - dy * tail;
            const trail = ctx.createLinearGradient(f.x, f.y, tx, ty);
            trail.addColorStop(0, "rgba(255, 190, 90, 0.85)");
            trail.addColorStop(0.35, "rgba(255, 90, 20, 0.45)");
            trail.addColorStop(1, "rgba(120, 20, 0, 0)");
            ctx.strokeStyle = trail;
            ctx.lineCap = "round";
            ctx.lineWidth = f.r * 1.6;
            ctx.beginPath();
            ctx.moveTo(f.x, f.y);
            ctx.lineTo(tx, ty);
            ctx.stroke();

            // Halo
            const glow = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r * 4);
            glow.addColorStop(0, "rgba(255, 150, 50, 0.55)");
            glow.addColorStop(1, "rgba(255, 60, 0, 0)");
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(f.x, f.y, f.r * 4, 0, Math.PI * 2);
            ctx.fill();

            // Núcleo
            const core = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, f.r);
            core.addColorStop(0, "rgba(255, 255, 230, 1)");
            core.addColorStop(0.45, "rgba(255, 210, 90, 1)");
            core.addColorStop(1, "rgba(255, 90, 10, 0.9)");
            ctx.fillStyle = core;
            ctx.beginPath();
            ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
            ctx.fill();
        }

        function frame(time: number) {
            if (!running) return;
            const dt = Math.min(0.05, (time - lastTime) / 1000 || 0);
            lastTime = time;

            // Aparición: tranquila normalmente, intensa durante invasión de dragones
            const interval = dragonInvasion ? rand(0.08, 0.25) : rand(0.9, 2.2);
            spawnTimer -= dt;
            if (spawnTimer <= 0) {
                spawn();
                spawnTimer = interval;
            }

            ctx.clearRect(0, 0, width, height);
            ctx.globalCompositeOperation = "lighter";

            for (let i = fireballs.length - 1; i >= 0; i--) {
                const f = fireballs[i];
                f.x += f.vx * dt;
                f.y += f.vy * dt;
                f.life += dt;

                // Chispas que se desprenden
                if (Math.random() < 0.7) {
                    addSpark(f.x + rand(-f.r, f.r), f.y + rand(-f.r, f.r),
                        -f.vx * 0.08 + rand(-20, 20), -f.vy * 0.08 + rand(-30, 10),
                        rand(0.3, 0.7), rand(0.8, 1.8));
                }

                if (f.y >= f.groundY || f.x < -60) {
                    if (f.y >= f.groundY && !f.long) explode(f);
                    fireballs.splice(i, 1);
                    continue;
                }
                drawFireball(f);
            }

            for (let i = blasts.length - 1; i >= 0; i--) {
                const b = blasts[i];
                b.t += dt;
                const p = b.t / 0.45;
                if (p >= 1) { blasts.splice(i, 1); continue; }
                const g = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * (0.5 + p));
                g.addColorStop(0, `rgba(255, 200, 120, ${0.6 * (1 - p)})`);
                g.addColorStop(1, "rgba(255, 60, 0, 0)");
                ctx.fillStyle = g;
                ctx.beginPath();
                ctx.arc(b.x, b.y, b.r * (0.5 + p), 0, Math.PI * 2);
                ctx.fill();
            }

            for (let i = sparks.length - 1; i >= 0; i--) {
                const s = sparks[i];
                s.life -= dt;
                if (s.life <= 0) { sparks.splice(i, 1); continue; }
                s.vy += 260 * dt; // gravedad
                s.x += s.vx * dt;
                s.y += s.vy * dt;
                const alpha = s.life / s.maxLife;
                ctx.fillStyle = `hsla(${s.hue}, 100%, ${55 + alpha * 25}%, ${alpha})`;
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size * (0.5 + alpha * 0.5), 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.globalCompositeOperation = "source-over";
            requestAnimationFrame(frame);
        }

        function updateRunning() {
            const shouldRun = !document.hidden;
            if (shouldRun && !running) {
                running = true;
                lastTime = performance.now();
                requestAnimationFrame(frame);
            } else if (!shouldRun) {
                running = false;
            }
        }

        resize();
        checkInvasion();
        setInterval(checkInvasion, 30_000);
        window.addEventListener("resize", resize);
        document.addEventListener("visibilitychange", updateRunning);
        updateRunning();
    }
</script>
