---
import { Image } from "astro:assets";
import eventsImg from "../assets/img/events.png"
import RankTable from "./RankTable.astro";
import OnlinePlayers from "./OnlinePlayers.astro";
---

<main id="container" class="bg-blur">
	<section class="mid">
		<slot></slot>
	</section>
	<section class="right">
		<div class="right-container">

			<OnlinePlayers/>
			<hr>
			<RankTable/>
			<hr>
			<Image
				src={eventsImg}
				alt="Imagen principal"
				class:list={"hero-img"}
			/>
		</div>
	</section>
</main>
<style>
	main{
		box-sizing: border-box;
		padding: 20px 0;
		position: relative;
		transform: translateY(-10vh);
		margin: 0 auto;
		width: 100%;
        max-width: var(--max-w);
		border-radius: 15px;
		color: var(--fg);
		display: flex;
		flex: 1;
		box-shadow: 0px 10px 30px 2px color-mix(in srgb, currentColor 10%, transparent);
	}
	.left,
	.mid,
	.right{
		box-sizing: border-box;
		min-width: 0;
		padding: 20px;
	}

	.left{
		flex: 2;
	}

	.mid {
		flex: 5;
	}

	.right{
		flex: 2;
	}

	.right-container{
		width: 100%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
</style>
