---
import EventBanners from "./EventBanners.astro";
import RankTable from "./RankTable.astro";
import OnlinePlayers from "./OnlinePlayers.astro";
import LoginWidget from "./LoginWidget.astro";
import PageHeading from "./PageHeading.astro";
import { config } from "../constants/config";

// Con el banner completo en páginas internas, el título va al inicio del contenedor
const heading = config.pages.hero === 'completo' ? Astro.locals.pageHeading : undefined;
---

<main id="container" class="bg-blur">
	<section class="mid">
		{heading && <PageHeading eyebrow={heading.eyebrow} title={heading.title} lead={heading.lead} />}
		<slot></slot>
	</section>
	<section class="right">
		<div class="right-container">

			<OnlinePlayers/>
			<LoginWidget />
			<RankTable/>
			<EventBanners />
		</div>
	</section>
</main>
<style>
	main{
		box-sizing: border-box;
		padding: 32px 12px;
		position: relative;
		/* por encima de la lluvia de fuego (z-index 1) */
		z-index: 2;
		/* se monta sobre el borde inferior del banner: ahí se luce el vidrio con blur */
		transform: translateY(-10vh);
		margin: 0 auto;
		width: 100%;
        max-width: var(--max-w);
		border-radius: 15px;
		color: var(--fg);
		display: flex;
		flex: 1;
		box-shadow: 0px 10px 30px 2px color-mix(in srgb, currentColor 10%, transparent);
	}
	.left,
	.mid,
	.right{
		box-sizing: border-box;
		min-width: 0;
		padding: 20px 24px;
	}

	.left{
		flex: 2;
	}

	.mid {
		flex: 5;
	}

	.right{
		flex: 2;
	}

	.right-container{
		width: 100%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
	}

	/* aire entre ítems de listas del contenido (especificidad 0: los componentes pueden pisarlo) */
	.mid :global(:where(ul, ol) > li + li) {
		margin-top: 6px;
	}

	.right-container > :global(*) {
		max-width: 100%;
	}

	/* Portada: el banner a pantalla completa es la presentación; el contenido empieza
	   justo debajo y, con el parallax, se desliza sobre la imagen al scrollear */
	:global(body.hero-full) main {
		transform: translateY(-48px);
	}

	/* Páginas internas con franja: el vidrio se monta apenas sobre su borde inferior */
	:global(body.hero-strip) main {
		transform: translateY(-36px);
	}

	@media (max-width: 760px) {
		main {
			flex-direction: column;
			padding: 8px 0;
			border-radius: 10px;
			transform: translateY(-6vh);
		}

		:global(body.hero-strip) main {
			transform: translateY(-18px);
		}

		/* portada en celular: la presentación va debajo de la imagen, sin superposición */
		:global(body.hero-full) main {
			transform: none;
			margin-top: 24px;
		}

		.mid,
		.right {
			padding: 14px 16px;
		}

		.right {
			border-top: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
		}

		.right-container {
			max-width: 480px;
			margin: 0 auto;
		}
	}

	@media (max-width: 480px) {
		main {
			border-radius: 0;
		}

		.mid,
		.right {
			padding: 12px;
		}
	}
</style>
