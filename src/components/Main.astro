---
import EventBanners from "./EventBanners.astro";
import RankTable from "./RankTable.astro";
import OnlinePlayers from "./OnlinePlayers.astro";
import LoginWidget from "./LoginWidget.astro";
---

<main id="container" class="bg-blur">
	<section class="mid">
		<slot></slot>
	</section>
	<section class="right">
		<div class="right-container">

			<OnlinePlayers/>
			<LoginWidget />
			<RankTable/>
			<EventBanners />
		</div>
	</section>
</main>
<style>
	main{
		box-sizing: border-box;
		padding: 20px 0;
		position: relative;
		transform: translateY(-10vh);
		margin: 0 auto;
		width: 100%;
        max-width: var(--max-w);
		border-radius: 15px;
		color: var(--fg);
		display: flex;
		flex: 1;
		box-shadow: 0px 10px 30px 2px color-mix(in srgb, currentColor 10%, transparent);
	}
	.left,
	.mid,
	.right{
		box-sizing: border-box;
		min-width: 0;
		padding: 20px;
	}

	.left{
		flex: 2;
	}

	.mid {
		flex: 5;
	}

	.right{
		flex: 2;
	}

	.right-container{
		width: 100%;
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
	}

	.right-container > :global(*) {
		max-width: 100%;
	}

	.right-container :global(.mu-box) {
		margin: 0;
	}

	.right-container :global(.mu-table th),
	.right-container :global(.mu-table td) {
		padding: 7px 5px;
		text-align: left;
	}

	/* Columna "#" angosta; las numéricas a la derecha */
	.right-container :global(.mu-table th:first-child),
	.right-container :global(.mu-table td:first-child) {
		width: 1.8em;
		text-align: center;
	}

	.right-container :global(.mu-table th:nth-child(n+3)),
	.right-container :global(.mu-table td:nth-child(n+3)) {
		width: 3.5em;
		text-align: right;
	}

	.right-container :global(.mu-table td:nth-child(2)) {
		overflow-wrap: anywhere;
	}


	@media (max-width: 760px) {
		main {
			flex-direction: column;
			padding: 8px 0;
			border-radius: 10px;
			transform: translateY(-6vh);
		}

		.mid,
		.right {
			padding: 14px 16px;
		}

		.right {
			border-top: 1px solid color-mix(in srgb, var(--fg) 25%, transparent);
		}

		.right-container {
			max-width: 480px;
			margin: 0 auto;
		}
	}

	@media (max-width: 480px) {
		main {
			border-radius: 0;
		}

		.mid,
		.right {
			padding: 12px;
		}
	}
</style>
