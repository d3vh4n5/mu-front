---
// Top 10 del servidor. Lista flexible: en columnas angostas (sidebar) la clase
// va debajo del nombre; con más ancho (celular, tablet) pasa a su propia columna.
---

<div class="rank-box">
  <h3>Top 10 Guerreros</h3>
  <div class="rank-list">
    <div class="rank-row rank-head" aria-hidden="true">
      <span>#</span>
      <span>Personaje</span>
      <span class="rank-class-col">Clase</span>
      <span class="num">Nivel</span>
      <span class="num">Resets</span>
    </div>
    <ol id="ranking-body" class="rank-body">
      <li class="rank-empty">Cargando ranking...</li>
    </ol>
  </div>
</div>

<style>
  .rank-box {
    width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(207, 178, 121, 0.3);
    border-radius: 10px;
    background: rgba(14, 6, 4, 0.6);
    color: #f3e8d2;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
  }

  .rank-box h3 {
    margin: 0;
    padding: 12px 10px;
    font-size: 16px;
    text-align: center;
    background: linear-gradient(180deg, rgba(120, 30, 10, 0.65), rgba(70, 19, 3, 0.65));
    color: var(--color-danger);
    border-bottom: 1px solid rgba(207, 178, 121, 0.35);
    text-shadow: 0 1px 2px #000;
  }

  @media (max-width: 480px) {
    .rank-box { margin: 14px 0; }
  }

  .rank-list {
    container-type: inline-size;
  }

  .rank-body {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rank-list :global(.rank-row) {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto auto;
    gap: 8px;
    align-items: center;
    padding: 7px 10px;
    border-bottom: 1px solid rgba(207, 178, 121, 0.1);
    font-size: 12px;
  }

  .rank-head {
    color: var(--color-danger);
    font-size: 11px !important;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom-color: rgba(207, 178, 121, 0.35) !important;
  }

  .rank-list :global(.rank-row:nth-child(even)) { background-color: rgba(207, 178, 121, 0.04); }
  .rank-head.rank-row { background-color: rgba(120, 30, 10, 0.3); }
  .rank-body :global(.rank-row:hover) { background-color: rgba(120, 30, 10, 0.2); }
  .rank-body :global(.rank-row:last-child) { border-bottom: 0; }

  .rank-list :global(.num) {
    min-width: 34px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .rank-list :global(.rank-pos) {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 700;
    color: #f5deb3;
  }

  .rank-list :global(.rank-pos.top1) { background: #d4af37; color: #1a1200; }
  .rank-list :global(.rank-pos.top2) { background: #b8b8c0; color: #15151a; }
  .rank-list :global(.rank-pos.top3) { background: #b0733a; color: #1a0d00; }

  .rank-list :global(.rank-name) {
    min-width: 0;
  }

  .rank-list :global(.rank-name strong),
  .rank-list :global(.rank-name small) {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rank-list :global(.rank-name small) {
    font-size: 10px;
    opacity: 0.7;
  }

  .rank-list :global(.rank-resets) {
    color: #d4af37;
    font-weight: 700;
  }

  /* Columna de clase: oculta en angosto (va debajo del nombre) */
  .rank-list :global(.rank-class-col) {
    display: none;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.85;
  }

  .rank-empty {
    padding: 12px;
    text-align: center;
    font-size: 12px;
    opacity: 0.7;
  }

  @container (min-width: 300px) {
    .rank-list :global(.rank-row) {
      grid-template-columns: 26px minmax(0, 1.2fr) minmax(0, 1fr) 48px 52px;
      gap: 10px;
      padding: 8px 12px;
      font-size: 13px;
    }

    .rank-list :global(.rank-class-col) { display: block; }
    .rank-list :global(.rank-name small) { display: none; }
  }
</style>

<script>
type RankPlayer = {
  Name: string;
  Class: number | null;
  className?: string;
  cLevel: number | null;
  Resets: number;
};

const esc = (value: unknown) =>
  String(value ?? '').replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);

async function loadRankingData() {
  const list = document.getElementById('ranking-body');
  if (!list) return;

  try {
    const res = await fetch('/api/ranking');
    const players: RankPlayer[] = await res.json();
    if (!Array.isArray(players) || players.length === 0) {
      list.innerHTML = '<li class="rank-empty">Todavía no hay guerreros en el ranking.</li>';
      return;
    }

    list.innerHTML = players.map((p, i) => {
      const pos = i + 1;
      const medal = pos <= 3 ? ` top${pos}` : '';
      const cls = esc(p.className ?? '');
      return `
        <li class="rank-row">
          <span class="rank-pos${medal}">${pos}</span>
          <span class="rank-name"><strong>${esc(p.Name)}</strong>${cls ? `<small>${cls}</small>` : ''}</span>
          <span class="rank-class-col">${cls || '-'}</span>
          <span class="num">${esc(p.cLevel ?? 0)}</span>
          <span class="num rank-resets">${esc(p.Resets ?? 0)}</span>
        </li>`;
    }).join('');
  } catch (error) {
    console.error('Error cargando datos del servidor', error);
    if (!list.querySelector('.rank-row')) {
      list.innerHTML = '<li class="rank-empty">No se pudo cargar el ranking.</li>';
    }
  }
}

loadRankingData();
setInterval(loadRankingData, 30000);
</script>
