---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import TermsContent from '../components/TermsContent.astro';
---

<Layout heading={{ eyebrow: "Información del servidor", title: "Términos y condiciones", lead: "Lee las condiciones de uso de MU Campana antes de crear tu cuenta." }} title="Términos y condiciones" description="Términos y condiciones de uso de Mu Campana: conducta, cliente, cuentas, sanciones y tratamiento de datos.">
	<Main>
		<div class="container">
			<section class="terms-page">
				<TermsContent />
				<div class="terms-actions">
					<a class="btn" href="/register">Crear cuenta</a>
					<a class="btn" href="/">Volver al inicio</a>
				</div>
			</section>
		</div>
	</Main>
</Layout>

<style>
	.container {
		width: 100%;
	}

	.terms-page {
		margin-top: 24px;
		padding: 22px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background: var(--bg-transparent);
	}

	.terms-page .terms-content {
		max-width: 760px;
		margin: 0 auto;
	}

	.terms-actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
	}

	@media (max-width: 620px) {
		.terms-page {
			padding: 14px;
		}

		.terms-actions {
			flex-direction: column;
		}

		.terms-actions .btn {
			text-align: center;
		}
	}
</style>
