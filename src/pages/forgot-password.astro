---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout heading={{ eyebrow: "Tu cuenta", title: "Recuperar contraseña", lead: "Te enviaremos un enlace a tu correo para crear una nueva." }} title="Recuperar contraseña" noindex>
  <Main>
    <div class="container">
      <section class="form-card">
        <div id="message" role="status" aria-live="polite"></div>
        <form id="forgotPasswordForm">
          <div class="input-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" autocomplete="email" required>
          </div>
          <button type="submit" class="btn primary">Enviar enlace</button>
        </form>
      </section>
    </div>
  </Main>
</Layout>

<style>
  .container {
    width: 100%;
  }

  .input-group {
    margin-bottom: 18px;
  }

  .primary {
    width: 100%;
  }

  #message:empty {
    display: none;
  }

  #message {
    margin-bottom: 15px;
    text-align: center;
    font-size: 14px;
  }

  button {
    cursor: pointer;
  }
</style>

<script>
  const form = document.getElementById('forgotPasswordForm') as HTMLFormElement | null;
  const email = document.getElementById('email') as HTMLInputElement | null;
  const message = document.getElementById('message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!email || !message) return;

    message.textContent = 'Procesando...';
    message.className = '';

    try {
      const response = await fetch('/api/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.value }),
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || result.error || 'No se pudo solicitar la recuperación');
      }

      message.textContent = result.message || 'Te enviamos un enlace para recuperar tu contraseña.';
      message.className = 'success';
      form.reset();
    } catch (error) {
      console.error(error);
      message.textContent = error instanceof Error ? error.message : 'No se pudo conectar con la API';
      message.className = 'error';
    }
  });
</script>