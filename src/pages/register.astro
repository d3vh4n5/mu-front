---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import infoImg from '../assets/img/top-decorator.gif'
import { Image } from 'astro:assets';
import TermsContent from '../components/TermsContent.astro';
---

<Layout>
	<Main>
		<div class="container">
			<Image
				src={infoImg}
				alt=""
				class:list={"noticias"}
			/>
			<div class="register-heading">
				<p class="eyebrow">Únete a la comunidad</p>
				<h1>Crear cuenta</h1>
				<p>Prepara tu personaje y sé parte de la aventura desde el comienzo.</p>
			</div>
			<section class="register-layout">
				<div class="register-benefits">
					<h2>Tu aventura empieza aquí</h2>
					<p>Regístrate para acceder al servidor, descargar el cliente y comenzar a construir tu propia historia en MU Campana.</p>
					<ul>
						<li>Accede a una experiencia clásica de MU Online.</li>
						<li>Compite en eventos y escala en el ranking.</li>
						<li>Recibe tu contraseña de forma segura por correo.</li>
					</ul>
				</div>
				<div class="register-form-wrapper">
				<div id="message" role="status" aria-live="polite"></div>
				<form id="registerForm">
					<div class="input-group">
						<label for="username">Nombre de usuario</label>
						<input type="text" id="username" maxlength="10" autocomplete="username" placeholder="Máximo 10 caracteres" required>
						<small>Será el nombre con el que ingresarás al juego.</small>
					</div>
					<div class="input-group">
						<label for="name">Nombre real</label>
						<input type="text" id="name" maxlength="10" autocomplete="name" placeholder="Máximo 10 caracteres" required>
						<small>Debe tener como máximo 10 caracteres.</small>
					</div>
					<div class="input-group">
						<label for="email">Correo electrónico</label>
						<input type="email" id="email" autocomplete="email" placeholder="tu-correo@ejemplo.com" required>
						<small>Lo necesitarás para recibir tu contraseña y recuperar la cuenta.</small>
					</div>
					<div class="terms-choice">
						<input type="radio" id="acceptTerms" name="terms" value="accepted" required>
						<label for="acceptTerms">Acepto los <button type="button" class="terms-link" id="openTerms">términos y condiciones</button>.</label>
					</div>
					<p class="terms-help">Verifica que tu correo sea correcto: allí recibirás la contraseña de tu cuenta.</p>
					<button type="submit" class="btn btn-success primary">Crear mi cuenta</button>
					<p class="form-link"><a href="/forgot-password">¿Olvidaste tu contraseña?</a></p>
				</form>
				</div>
			</section>
			<dialog id="termsDialog" aria-labelledby="termsTitle">
				<div class="dialog-header">
					<h2 id="termsTitle">Términos y condiciones</h2>
					<button type="button" class="close-dialog" id="closeTerms" aria-label="Cerrar términos">&times;</button>
				</div>
				<TermsContent />
				<button type="button" class="btn" id="closeTermsBottom">Entendido</button>
			</dialog>
		</div>
	</Main>
</Layout>
<style>
	.noticias{
		width: 100%;
	}

	.container {
		width: 100%;
	}

	.register-heading {
		text-align: center;
	}

	.eyebrow {
		margin: 18px 0 0;
		color: var(--color-danger);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	h1 {
		text-align: center;
		text-transform: uppercase;
		letter-spacing: 2px; 
	}

	.register-heading > p:last-child {
		font-size: 14px;
	}

	.register-layout {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 24px;
		align-items: start;
		margin-top: 24px;
	}

	.register-benefits,
	.register-form-wrapper {
		padding: 20px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background-color: var(--bg-transparent);
	}

	.register-benefits h2 {
		margin-top: 0;
		color: var(--color-danger);
	}

	.register-benefits p,
	.register-benefits li,
	.terms-help {
		line-height: 1.6;
	}

	.register-benefits ul {
		padding-left: 20px;
	}

	.register-benefits li {
		margin-bottom: 10px;
	}

	.input-group {
		margin-bottom: 15px;
	}
	label {
		display: block;
		margin-bottom: 5px;
		font-size: 13px;
		font-weight: 700;
	}

	small {
		display: block;
		margin-top: 5px;
		font-size: 11px;
		opacity: 0.8;
	}

	input {
		border: 1px solid var(--fg);
		border-radius: 4px;
		background-color: var(--fg);
		color: var(--fg);
		width: 100%;
		padding: 10px;
		box-sizing: border-box;
		background-color: rgba(0, 0, 0, 0.2);
	}
	input:focus {
		outline: 2px solid var(--color-primary);
		outline-offset: 1px;
	}

	input::placeholder {
		color: color-mix(in srgb, var(--fg) 65%, transparent);
	}

	#message {
		margin-bottom: 15px;
		text-align: center;
		font-size: 14px;
	}

	.terms-help {
		font-size: 11px;
		opacity: 0.85;
	}

	.terms-choice {
		display: flex;
		gap: 8px;
		align-items: flex-start;
		margin: 18px 0 4px;
		padding: 10px 12px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.2);
	}

	.terms-choice input {
		width: auto;
		height: 14px;
		padding: 0;
		margin: 2px 0 0;
		border: 0;
		accent-color: var(--color-primary);
		flex: 0 0 auto;
	}

	.terms-choice label {
		margin: 0;
		font-size: 11px;
		font-weight: 400;
		line-height: 1.5;
	}

	.terms-link {
		display: inline;
		width: auto;
		padding: 0;
		border: 0;
		background: none;
		color: var(--color-danger);
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}

	dialog {
		width: min(460px, calc(100% - 32px));
		max-height: min(680px, calc(100vh - 48px));
		box-sizing: border-box;
		overflow-y: auto;
		border: 1px solid var(--color-danger);
		border-radius: 5px;
		padding: 22px;
		background: #0e0e0e;
		color: var(--fg);
		box-shadow: 0 0 24px rgba(0, 0, 0, 0.75);
	}

	dialog::backdrop {
		background: rgba(0, 0, 0, 0.75);
	}

	.dialog-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.dialog-header h2 {
		margin: 0;
		color: var(--color-danger);
	}

	.close-dialog {
		width: 32px;
		height: 32px;
		padding: 0;
		flex: 0 0 32px;
		border: 0;
		background: transparent;
		color: var(--fg);
		font-size: 26px;
		line-height: 1;
		cursor: pointer;
		border-radius: 4px;
	}

	.close-dialog:hover,
	.close-dialog:focus-visible {
		background: rgba(255, 165, 0, 0.18);
		outline: 1px solid var(--color-danger);
	}

	dialog p {
		line-height: 1.6;
	}

	.dialog-header + .terms-intro {
		margin-top: 18px;
	}

	dialog h3 {
		margin: 22px 0 8px;
		font-size: 14px;
		text-align: left;
		background: none;
		color: var(--color-danger);
	}

	dialog ul {
		padding-left: 20px;
		line-height: 1.6;
	}

	dialog li {
		margin-bottom: 8px;
	}

	button {
		cursor: pointer;
		font-size: 14px;
	}

	.primary {
		width: 100%;
	}

	#closeTermsBottom {
		width: auto;
	}

	.form-link {
		text-align: center;
	}

	.form-link a {
		color: var(--fg);
	}

	@media (max-width: 620px) {
		.register-layout {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	import { throwConfetti } from '@/utils/confetti';

const form = document.querySelector<HTMLFormElement>('#registerForm');
const username = document.querySelector<HTMLInputElement>('#username');
const name = document.querySelector<HTMLInputElement>('#name');
const email = document.querySelector<HTMLInputElement>('#email');
const msgDiv = document.querySelector<HTMLDivElement>('#message');
const terms = document.querySelector<HTMLInputElement>('#acceptTerms');
const termsDialog = document.querySelector<HTMLDialogElement>('#termsDialog');
const openTerms = document.querySelector<HTMLButtonElement>('#openTerms');
const closeTerms = document.querySelector<HTMLButtonElement>('#closeTerms');
const closeTermsBottom = document.querySelector<HTMLButtonElement>('#closeTermsBottom');

openTerms?.addEventListener('click', () => termsDialog?.showModal());
closeTerms?.addEventListener('click', () => termsDialog?.close());
closeTermsBottom?.addEventListener('click', () => termsDialog?.close());

termsDialog?.addEventListener('click', (event) => {
	if (event.target === termsDialog) termsDialog.close();
});

form?.addEventListener('submit', async (e) => {
	e.preventDefault();
	if (!username || !name || !email || !terms || !msgDiv) return;

	if (username.value.length > 10 || name.value.length > 10) {
		msgDiv.innerHTML = '<span class="error">El nombre de usuario y el nombre real no pueden superar los 10 caracteres.</span>';
		return;
	}

	if (!terms.checked) {
		msgDiv.innerHTML = '<span class="error">Debes aceptar los términos y condiciones para crear la cuenta.</span>';
		return;
	}

	msgDiv.innerHTML = "Procesando...";

	const data = {
		username: username.value,
		name: name.value,
		email: email.value
	};

	try {
		const response = await fetch('/api/register', {
			method: 'POST',
			headers: { 'Content-Type': 'application/json' },
			body: JSON.stringify(data)
		});

		const result = await response.json();

		if (response.ok) {
			msgDiv.innerHTML = `<span class="success">Su cuenta se registró correctamente. Le enviamos un correo con su contraseña, recuerde revisar la bandeja de correo no deseado.</span>`;
			form.reset();
			form.innerHTML = '';
			throwConfetti()
		} else {
			msgDiv.innerHTML = `<span class="error">${result.message}</span>`;
		}
	} catch (error) {
		console.error(error)
		msgDiv.innerHTML = `<span class="error">No se pudo conectar con la API</span>`;
	}
});

</script>
