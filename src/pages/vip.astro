---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import { config } from '../constants/config';

const tiers = ["FREE", "VIP 1", "VIP 2", "VIP 3"];
const rows = [
  { group: "General", label: "Experiencia", values: ["x100", "x120", "x130", "x150"] },
  { group: "General", label: "Drop Items", values: ["40%", "50%", "60%", "70%"] },
  { group: "Resets", label: "Nivel Reset", values: ["400", "390", "370", "350"] },
  { group: "Resets", label: "Puntos por Reset", values: ["400", "500", "600", "800"] },
  { group: "Joyas", label: "Soul Success", values: ["50%", "55%", "60%", "75%"] },
  { group: "Joyas", label: "Life Success", values: ["50%", "55%", "60%", "75%"] },
  { group: "Chaos Mix", label: "Item +10 / +11", values: ["60%", "65%", "70%", "75%"] },
  { group: "Chaos Mix", label: "Item +12 / +13", values: ["50%", "55%", "60%", "65%"] },
  { group: "Chaos Mix", label: "Dinorant / Pets", values: ["70%", "75%", "80%", "85%"] },
];
---

<Layout heading={{ eyebrow: "Apoya el proyecto", title: `Socio VIP de ${config.project.alias}`, lead: "Tu aporte ayuda a mantener el servidor activo y la comunidad en crecimiento." }} title="Socio VIP" description="Apoya a Mu Campana con el sistema VIP: compara los beneficios de cada nivel frente a la modalidad FREE. El servidor sigue siendo gratuito para todos.">
	<Main>
		<div class="container">



			<section class="vip-intro">
				<div class="intro-copy">
					<h2>Una forma de sumar tu apoyo</h2>
					<p>MU Campana sigue siendo gratuito para todos. El sistema VIP ofrece beneficios temporales a quienes eligen aportar al mantenimiento, sin convertir la experiencia en un servidor pay-to-win.</p>
					<p>Elige el nivel que mejor se adapte a ti y revisa la comparación completa antes de aportar. Cada beneficio está pensado para acompañar tu progreso sin quitarle valor al esfuerzo dentro del juego.</p>
					<a class="btn" href="#beneficios">Ver beneficios VIP</a>
				</div>
				<div class="support-note">
					<strong>Tu aporte se transforma en servidor</strong>
					<p>Ayuda con el mantenimiento, la infraestructura y el desarrollo de nuevas experiencias para la comunidad.</p>
				</div>
			</section>

			<section id="beneficios" class="benefits-section">
				<div class="section-heading">
					<p class="eyebrow">Comparación de beneficios</p>
					<h2>Elige tu nivel VIP</h2>
					<p>Compara cada beneficio con la modalidad FREE y encuentra la opción que más te convenga.</p>
				</div>
				<div class="tier-list">
					{tiers.map((tier, index) => (
						<div class:list={["tier-card", index === 0 && "tier-free"]}>
							<strong>{tier}</strong>
							<span>{index === 0 ? "La experiencia base" : `Nivel de apoyo ${index}`}</span>
						</div>
					))}
				</div>
				<div class="table-card vip-table-card">
				<table class="data-table vip-table">
					<thead>
					<tr>
						<th>Categoría</th>
						<th>Beneficio</th>
						{tiers.map(t => <th>{t}</th>)}
					</tr>
					</thead>
					<tbody>
					{rows.map((row) => (
						<tr>
						<td>{row.group}</td>
						<td>{row.label}</td>
						{row.values.map((val, i) => (
							<td>
							{val}
							</td>
						))}
						</tr>
					))}
					</tbody>
				</table>
				</div>
			</section>

			<section class="vip-conditions">
				<h3>Antes de aportar</h3>
				<p>Los beneficios VIP son temporales y están sujetos a las condiciones del servidor. El aporte es voluntario, no es necesario para jugar y no otorga propiedad sobre cuentas, personajes, objetos o contenido.</p>
				<a href="/terms">Leer términos y condiciones</a>
			</section>
		</div>


	</Main>
</Layout>
<style>
	.eyebrow {
		margin: 18px 0 8px;
		color: var(--color-danger);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.vip-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(180px, 0.8fr);
		gap: 24px;
		align-items: center;
		margin: 26px 0 30px;
		padding: 22px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background: var(--bg-transparent);
	}

	.vip-intro h2,
	.section-heading h2 {
		margin-top: 0;
		color: var(--color-danger);
	}

	.vip-intro p,
	.section-heading p,
	.support-note p,
	.vip-conditions p {
		line-height: 1.6;
	}

	.support-note {
		padding: 16px;
		border-left: 3px solid var(--color-danger);
		background: rgba(0, 0, 0, 0.2);
	}

	.support-note strong {
		font-size: 14px;
	}

	.benefits-section {
		scroll-margin-top: 60px;
	}

	.section-heading {
		text-align: center;
	}

	.section-heading .eyebrow {
		margin-bottom: 4px;
	}

	.tier-list {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		margin: 20px 0 10px;
	}

	.tier-card {
		display: flex;
		min-height: 58px;
		padding: 10px;
		flex-direction: column;
		justify-content: center;
		border: 1px solid rgba(207, 178, 121, 0.45);
		border-radius: 8px;
		background: linear-gradient(160deg, rgba(120, 30, 10, 0.55), rgba(60, 16, 4, 0.6));
		box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
		text-align: center;
	}

	.tier-card strong {
		font-size: 14px;
		color: var(--color-danger);
	}

	.tier-card span {
		margin-top: 5px;
		font-size: 10px;
	}

	.tier-free {
		border-color: color-mix(in srgb, var(--fg) 55%, transparent);
		background: rgba(0, 0, 0, 0.2);
	}

	.tier-free strong {
		color: var(--fg);
	}

	.vip-table {
		min-width: 650px;
	}

	.vip-table th,
	.vip-table td {
		text-align: center;
	}

	.vip-table th:nth-child(-n+2),
	.vip-table td:nth-child(-n+2) {
		text-align: left;
	}

	.vip-table td:first-child {
		color: var(--color-gold-soft);
		font-size: 12px;
	}

	/* columnas VIP: valores en dorado */
	.vip-table td:nth-child(n+4) {
		color: var(--color-danger);
		font-weight: 700;
	}

	.vip-conditions {
		margin-top: 30px;
		padding: 18px 20px;
		border-top: 2px solid var(--color-danger);
		background: var(--bg-transparent);
		text-align: center;
	}

	.vip-conditions h3 {
		margin-top: 0;
	}

	.vip-conditions a {
		color: var(--color-danger);
		font-weight: 700;
	}

	@media (max-width: 620px) {
		.vip-intro {
			grid-template-columns: 1fr;
			padding: 16px;
		}

		.tier-list {
			grid-template-columns: repeat(2, 1fr);
		}

		.vip-table-card {
			margin: 0 -4px;
		}
	}
</style>