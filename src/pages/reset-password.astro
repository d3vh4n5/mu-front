---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import infoImg from '../assets/img/top-decorator.gif';
import { Image } from 'astro:assets';
---

<Layout>
  <Main>
    <div class="container">
      <Image src={infoImg} alt="Imagen" class:list="noticias" />
      <h1>Restablecer contraseña</h1>
      <section>
        <div id="message" role="status" aria-live="polite">Validando el enlace...</div>
        <div id="passwordContainer" class="password-container" hidden>
          <label for="newPassword">Tu nueva contraseña</label>
          <div class="password-field">
            <input id="newPassword" type="password" readonly aria-label="Nueva contraseña" />
            <button id="togglePassword" type="button" class="btn" aria-pressed="false">
              Mostrar
            </button>
          </div>
          <p>Anótala en un lugar seguro antes de cerrar esta página.</p>
        </div>
      </section>
    </div>
  </Main>
</Layout>

<style>
  .container {
    width: 100%;
  }

  .noticias {
    width: 100%;
  }

  h1 {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  #message {
    margin-top: 15px;
    text-align: center;
    font-size: 14px;
  }

  .password-container {
    margin-top: 24px;
  }

  .password-container[hidden] {
    display: none;
  }

  label {
    display: block;
    margin-bottom: 5px;
    font-size: 12px;
  }

  .password-field {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  input {
    border: 1px solid var(--fg);
    border-radius: 4px;
    background-color: transparent;
    color: var(--fg);
    flex: 1;
    min-width: 0;
    padding: 10px;
    box-sizing: border-box;
  }

  input:focus {
    outline: none;
  }

  .password-container p {
    text-align: center;
  }

  @media (max-width: 480px) {
    .password-field {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>

<script>
  const message = document.getElementById('message');
  const passwordContainer = document.getElementById('passwordContainer');
  const newPassword = document.getElementById('newPassword') as HTMLInputElement | null;
  const togglePassword = document.getElementById('togglePassword') as HTMLButtonElement | null;

  const showMessage = (text: string, className: 'success' | 'error') => {
    if (!message) return;
    message.textContent = text;
    message.className = className;
  };

  const token = new URLSearchParams(window.location.search).get('token');

  if (!token) {
    showMessage('El enlace de recuperación no es válido o está incompleto.', 'error');
  } else {
    fetch('/api/reset-password', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ token }),
    })
      .then(async (response) => {
        const result = await response.json();
        if (!response.ok) {
          throw new Error(result.message || result.error || 'El enlace de recuperación no es válido');
        }
        return result;
      })
      .then((result) => {
        showMessage(result.message || 'La contraseña fue actualizada correctamente.', 'success');
        if (newPassword && passwordContainer) {
          newPassword.value = String(result.newPassword);
          passwordContainer.hidden = false;
        }
      })
      .catch((error: Error) => {
        showMessage(error.message || 'No se pudo conectar con la API.', 'error');
      });
  }

  togglePassword?.addEventListener('click', () => {
    if (!newPassword || !togglePassword) return;
    const isVisible = newPassword.type === 'text';
    newPassword.type = isVisible ? 'password' : 'text';
    togglePassword.textContent = isVisible ? 'Mostrar' : 'Ocultar';
    togglePassword.setAttribute('aria-pressed', String(!isVisible));
  });
</script>
