---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import infoImg from '../assets/img/top-decorator.gif';
import { Image } from 'astro:assets';
---

<Layout>
  <Main>
    <div class="container">
      <Image src={infoImg} alt="Imagen" class:list="noticias" />
      <h1>Recuperar contraseña</h1>
      <section>
        <div id="message" role="status" aria-live="polite"></div>
        <form id="forgotPasswordForm">
          <div class="input-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" autocomplete="email" required>
          </div>
          <p>Te enviaremos un enlace para crear una nueva contraseña.</p>
          <button type="submit" class="btn primary">ENVIAR ENLACE</button>
        </form>
      </section>
    </div>
  </Main>
</Layout>

<style>
  .container {
    width: 100%;
  }

  .noticias {
    width: 100%;
  }

  h1 {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .input-group {
    margin-bottom: 15px;
  }

  label {
    display: block;
    margin-bottom: 5px;
    font-size: 12px;
  }

  input {
    border: 1px solid var(--fg);
    border-radius: 4px;
    background-color: transparent;
    color: var(--fg);
    width: 100%;
    padding: 10px;
    box-sizing: border-box;
  }

  input:focus {
    outline: none;
  }

  #message {
    margin-top: 15px;
    text-align: center;
    font-size: 14px;
  }

  button {
    cursor: pointer;
  }
</style>

<script>
  const form = document.getElementById('forgotPasswordForm') as HTMLFormElement | null;
  const email = document.getElementById('email') as HTMLInputElement | null;
  const message = document.getElementById('message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!email || !message) return;

    message.textContent = 'Procesando...';
    message.className = '';

    try {
      const response = await fetch('/api/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.value }),
      });
      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || result.error || 'No se pudo solicitar la recuperación');
      }

      message.textContent = result.message || 'Te enviamos un enlace para recuperar tu contraseña.';
      message.className = 'success';
      form.reset();
    } catch (error) {
      console.error(error);
      message.textContent = error instanceof Error ? error.message : 'No se pudo conectar con la API';
      message.className = 'error';
    }
  });
</script>