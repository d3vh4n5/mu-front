---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import TermsContent from '../components/TermsContent.astro';
import infoImg from '../assets/img/top-decorator.gif';
import { Image } from 'astro:assets';
---

<Layout>
	<Main>
		<div class="container">
			<Image src={infoImg} alt="" class:list="noticias" />
			<div class="page-heading">
				<p class="eyebrow">Información del servidor</p>
				<h1>Términos y condiciones</h1>
				<p>Lee las condiciones de uso de MU Campana antes de crear tu cuenta.</p>
			</div>
			<section class="terms-page">
				<TermsContent />
				<div class="terms-actions">
					<a class="btn btn-success" href="/register">Crear cuenta</a>
					<a class="btn" href="/">Volver al inicio</a>
				</div>
			</section>
		</div>
	</Main>
</Layout>

<style>
	.container {
		width: 100%;
	}

	.noticias {
		width: 100%;
	}

	.page-heading {
		text-align: center;
	}

	.eyebrow {
		margin: 18px 0 0;
		color: var(--color-danger);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	h1 {
		margin-bottom: 8px;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.page-heading > p:last-child {
		font-size: 14px;
	}

	.terms-page {
		margin-top: 24px;
		padding: 22px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background: var(--bg-transparent);
	}

	.terms-page .terms-content {
		max-width: 760px;
		margin: 0 auto;
	}

	.terms-actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		margin-top: 28px;
		padding-top: 20px;
		border-top: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
	}

	@media (max-width: 620px) {
		.terms-page {
			padding: 14px;
		}

		.terms-actions {
			flex-direction: column;
		}

		.terms-actions .btn {
			text-align: center;
		}
	}
</style>
