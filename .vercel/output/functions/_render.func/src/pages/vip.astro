---
import Main from '../components/Main.astro';
import Layout from '../layouts/Layout.astro';
import { config } from '../constants/config';
import { Image } from 'astro:assets';
import infoImg from '../assets/img/top-decorator.gif'

const tiers = ["FREE", "VIP 1", "VIP 2", "VIP 3"];
const rows = [
  { group: "General", label: "Experiencia", values: ["100%", "120%", "130%", "150%"] },
  { group: "General", label: "Drop Items", values: ["40%", "50%", "60%", "70%"] },
  { group: "Resets", label: "Nivel Reset", values: ["400", "390", "370", "350"] },
  { group: "Resets", label: "Puntos por Reset", values: ["400", "500", "600", "800"] },
  { group: "Joyas", label: "Soul Success", values: ["50%", "55%", "60%", "75%"] },
  { group: "Joyas", label: "Life Success", values: ["50%", "55%", "60%", "75%"] },
  { group: "Chaos Mix", label: "Item +10 / +11", values: ["60%", "65%", "70%", "75%"] },
  { group: "Chaos Mix", label: "Item +12 / +13", values: ["50%", "55%", "60%", "65%"] },
  { group: "Chaos Mix", label: "Dinorant / Pets", values: ["70%", "75%", "80%", "85%"] },
];
---

<Layout>
	<Main>
		<div class="container">

			<Image
				src={infoImg}
				alt={"Imagen"}
				class:list={"noticias"}
			/>

			<div class="vip-heading">
				<p class="eyebrow">Apoyá el proyecto</p>
				<h1>Socio VIP de {config.project.alias}</h1>
				<p class="lead">Tu aporte ayuda a mantener el servidor activo y la comunidad en crecimiento.</p>
			</div>

			<section class="vip-intro">
				<div class="intro-copy">
					<h2>Una forma de sumar tu apoyo</h2>
					<p>MU Campana sigue siendo gratuito para todos. El sistema VIP ofrece beneficios temporales a quienes eligen aportar al mantenimiento, sin convertir la experiencia en un servidor pay-to-win.</p>
					<p>Elegí el nivel que mejor se adapte a vos y revisá la comparación completa antes de aportar. Cada beneficio está pensado para acompañar tu progreso sin quitarle valor al esfuerzo dentro del juego.</p>
					<a class="btn btn-success" href="#beneficios">Ver beneficios VIP</a>
				</div>
				<div class="support-note">
					<strong>Tu aporte se transforma en servidor</strong>
					<p>Ayuda con el mantenimiento, la infraestructura y el desarrollo de nuevas experiencias para la comunidad.</p>
				</div>
			</section>

			<section id="beneficios" class="benefits-section">
				<div class="section-heading">
					<p class="eyebrow">Comparación de beneficios</p>
					<h2>Elegí tu nivel VIP</h2>
					<p>Compará cada beneficio con la modalidad FREE y encontrá la opción que más te convenga.</p>
				</div>
				<div class="tier-list">
					{tiers.map((tier, index) => (
						<div class:list={["tier-card", index === 0 && "tier-free"]}>
							<strong>{tier}</strong>
							<span>{index === 0 ? "La experiencia base" : `Nivel de apoyo ${index}`}</span>
						</div>
					))}
				</div>
				<div class="table-wrapper">
				<table>
					<caption>Comparación de beneficios entre la modalidad FREE y los niveles VIP</caption>
					<thead>
					<tr>
						<th scope="col">Categoría</th>
						<th scope="col">Beneficio</th>
						{tiers.map((tier, index) => <th class:list={{"vip-column": index > 0}} scope="col">{tier}</th>)}
					</tr>
					</thead>
					<tbody>
					{rows.map((row) => (
						<tr>
						<td class="category-cell">{row.group}</td>
						<td class="benefit-cell">{row.label}</td>
						{row.values.map((val, i) => (
						<td class:list={{"vip-column": i > 0}}>
							{val}
							</td>
						))}
						</tr>
					))}
					</tbody>
				</table>
				</div>
			</section>

			<section class="vip-conditions">
				<h3>Antes de aportar</h3>
				<p>Los beneficios VIP son temporales y están sujetos a las condiciones del servidor. El aporte es voluntario, no es necesario para jugar y no otorga propiedad sobre cuentas, personajes, objetos o contenido.</p>
				<a href="/terms">Leer términos y condiciones</a>
			</section>
		</div>


	</Main>
</Layout>
<style>
	.noticias {
		width: 100%;
	}

	.container {
		width: 100%;
		min-width: 0;
	}

	.vip-heading {
		text-align: center;
	}

	.eyebrow {
		margin: 18px 0 8px;
		color: var(--color-danger);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
	}

	.vip-heading h1 {
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.lead {
		font-size: 15px;
		line-height: 1.6;
	}

	.vip-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(180px, 0.8fr);
		gap: 24px;
		align-items: center;
		margin: 26px 0 30px;
		padding: 22px;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background: var(--bg-transparent);
	}

	.vip-intro h2,
	.section-heading h2 {
		margin-top: 0;
		color: var(--color-danger);
	}

	.vip-intro p,
	.section-heading p,
	.support-note p,
	.vip-conditions p {
		line-height: 1.6;
	}

	.support-note {
		padding: 16px;
		border-left: 3px solid var(--color-danger);
		background: rgba(0, 0, 0, 0.2);
	}

	.support-note strong {
		font-size: 14px;
	}

	.benefits-section {
		scroll-margin-top: 60px;
	}

	.section-heading {
		text-align: center;
	}

	.section-heading .eyebrow {
		margin-bottom: 4px;
	}

	.tier-list {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		margin: 20px 0 10px;
	}

	.tier-card {
		display: flex;
		min-height: 58px;
		padding: 10px;
		flex-direction: column;
		justify-content: center;
		border: 1px solid var(--color-danger);
		border-radius: 4px;
		background: linear-gradient(145deg, rgba(89, 43, 173, 0.45), rgba(70, 19, 3, 0.45));
		text-align: center;
	}

	.tier-card strong {
		font-size: 14px;
		color: var(--color-danger);
	}

	.tier-card span {
		margin-top: 5px;
		font-size: 10px;
	}

	.tier-free {
		border-color: color-mix(in srgb, var(--fg) 55%, transparent);
		background: rgba(0, 0, 0, 0.2);
	}

	.tier-free strong {
		color: var(--fg);
	}

	.table-wrapper {
		overflow-x: auto;
		border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
		border-radius: 5px;
		background: rgba(0, 0, 0, 0.2);
	}

	table {
		width: 100%;
		min-width: 760px;
		border-collapse: collapse;
		font-size: 13px;
		line-height: 1.4;
	}

	caption {
		padding: 12px;
		background: rgba(0, 0, 0, 0.35);
		color: var(--fg);
		font-size: 11px;
		text-align: left;
	}

	th,
	td {
		padding: 13px 12px;
		border-bottom: 1px solid color-mix(in srgb, var(--fg) 20%, transparent);
		text-align: center;
	}

	th {
		position: sticky;
		top: 0;
		z-index: 2;
		background: linear-gradient(90deg, var(--color-primary), var(--color-brown));
		color: var(--fg);
		font-size: 11px;
		text-transform: uppercase;
	}

	th:first-child,
	td:first-child {
		width: 105px;
		min-width: 105px;
		position: sticky;
		left: 0;
		z-index: 3;
		text-align: left;
	}

	th:nth-child(2),
	td:nth-child(2) {
		width: 185px;
		min-width: 185px;
		position: sticky;
		left: 105px;
		z-index: 3;
		text-align: left;
	}

	td:first-child,
	td:nth-child(2) {
		background: #16111b;
	}

	th:first-child,
	th:nth-child(2) {
		z-index: 4;
	}

	.category-cell {
		color: var(--color-danger);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.benefit-cell {
		font-weight: 700;
	}

	.vip-column {
		background: rgba(89, 43, 173, 0.14);
		font-weight: 700;
	}

	tbody .vip-column {
		color: #f0d39b;
	}

	tbody tr:nth-child(even) {
		background: rgba(0, 0, 0, 0.2);
	}

	tbody tr:nth-child(even) td:first-child,
	tbody tr:nth-child(even) td:nth-child(2) {
		background: #1e1722;
	}

	tbody tr:hover {
		background: rgba(255, 165, 0, 0.12);
	}

	.vip-conditions {
		margin-top: 30px;
		padding: 18px 20px;
		border-top: 2px solid var(--color-danger);
		background: var(--bg-transparent);
		text-align: center;
	}

	.vip-conditions h3 {
		margin-top: 0;
	}

	.vip-conditions a {
		color: var(--color-danger);
		font-weight: 700;
	}

	@media (max-width: 620px) {
		.vip-intro {
			grid-template-columns: 1fr;
			padding: 16px;
		}

		.tier-list {
			grid-template-columns: repeat(2, 1fr);
		}

		.table-wrapper {
			margin: 0 -4px;
		}
	}
</style>