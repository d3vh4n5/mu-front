{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/config/config/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/forgot-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/ranking/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/status/?$",
			"dest": "_render"
		},
		{
			"src": "^/downloads/?$",
			"dest": "_render"
		},
		{
			"src": "^/forgot-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/help/skills/?$",
			"dest": "_render"
		},
		{
			"src": "^/help/?$",
			"dest": "_render"
		},
		{
			"src": "^/register/?$",
			"dest": "_render"
		},
		{
			"src": "^/reset-password/?$",
			"dest": "_render"
		},
		{
			"src": "^/terms/?$",
			"dest": "_render"
		},
		{
			"src": "^/vip/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}